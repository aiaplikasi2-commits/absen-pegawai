# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used by server.ts to sign username/password session tokens.
JWT_SECRET="absensi-wajah-gps-production-secret-key"

# DEFAULT_ADMIN_USERNAME & DEFAULT_ADMIN_PASSWORD: Initial bootstrap admin credentials (hashed on first boot).
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="AdminPassword123!"
